POSTGRES_PORT=5435

SCRAPPER_HTTP_PORT=8010
SCRAPPER_GRPC_PORT=50052
SCRAPPER_HTTP_INTERNAL_PORT=8010
SCRAPPER_GRPC_INTERNAL_PORT=50052

BOT_HTTP_PORT=8009
BOT_GRPC_PORT=50051
BOT_HTTP_INTERNAL_PORT=8009
BOT_GRPC_INTERNAL_PORT=50051

ASPNETCORE_ENVIRONMENT=Production
DATABASE_ACCESS_TYPE=SQL
