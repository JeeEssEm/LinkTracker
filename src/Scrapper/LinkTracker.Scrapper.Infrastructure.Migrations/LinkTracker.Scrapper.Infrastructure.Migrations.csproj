<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="dbup-core" Version="6.1.1"/>
        <PackageReference Include="dbup-postgresql" Version="7.0.1"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\..\..\migrations\001-initial.sql">
            <Link>Migrations\001-initial.sql</Link>
        </EmbeddedResource>
        <EmbeddedResource Include="..\..\..\migrations\002-stackoverflow-tables.sql">
            <Link>Migrations\002-stackoverflow-tables.sql</Link>
        </EmbeddedResource>
        <EmbeddedResource Include="..\..\..\migrations\003-stackoverflow-question-comments.sql">
            <Link>Migrations\003-stackoverflow-question-comments.sql</Link>
        </EmbeddedResource>
        <EmbeddedResource Include="..\..\..\migrations\004-github.sql">
            <Link>Migrations\004-github.sql</Link>
        </EmbeddedResource>
        <EmbeddedResource Include="..\..\..\migrations\005-outbox.sql">
            <Link>Migrations\005-outbox.sql</Link>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.Development.json">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

</Project>
