  "DatabaseOptions": {
  },
  "NotificationStrategyOptions": {
    "Strategy": 0,
    "Topic": "link.raw-updates",
    "BootstrapServers": "localhost:19092,localhost:29092,localhost:39092"
  },
  
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:8010",
        "Protocols": "Http1"
      },
      "Grpc": {
        "Url": "http://localhost:50052",
        "Protocols": "Http2"
      }
    }
  }
