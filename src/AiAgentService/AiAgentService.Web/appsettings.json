{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KafkaConfiguration": {
    "ProducerTopic": "link.processed-updates",
    "ConsumerTopic": "link.raw-updates",
    "BootstrapServers": "localhost:19092,localhost:29092,localhost:39092",
    "GroupId": "ai agent service"
  },
  "Filtering": {
    "StopWords": [],
    "ExcludedAuthors": [],
    "MinLength": 5,
    "Summarization": {
      "Threshold": 50,
      "AiSummarizationEnabled": false
    }
  },
  "TopicConfiguration": {
    "NumPartitions": 1,
    "ReplicationFactor": 1,
    "InSyncReplicas": 1
  },
  "AiApiConfiguration": {
    "Url": "https://openrouter.ai",
    "ApiKey": ""
  }
}
